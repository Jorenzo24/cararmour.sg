# Car Armour SG — statique
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404/index.html

# Les sources du générateur ne sont jamais servies
RedirectMatch 404 ^/_src/
RedirectMatch 404 ^/\.
# Le site est servi depuis le repo (cPanel Git) : les notes internes et les
# fichiers de travail a la racine ne doivent pas etre lisibles
RedirectMatch 404 ^/[^/]+\.md$
RedirectMatch 404 ^/dist(/|\.zip$)

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# URLs propres : /page/ sert /page/index.html ; force le slash final
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Une seule adresse : https, sans www. Derriere Cloudflare en mode SSL
  # Flexible, Apache recoit du http et voit HTTPS a off : sans le test sur
  # X-Forwarded-Proto, la redirection tournerait en boucle. En Full (strict),
  # le premier test suffit ; garder les deux.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://cararmour.sg%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://cararmour.sg%{REQUEST_URI} [R=301,L]

  # Anciennes URL du site WordPress (sitemap releve le 2026-10-20)
  RewriteRule ^wp-sitemap.*\.xml$ /sitemap.xml [R=301,L]
  RewriteRule ^(home-final|sample-page|shop|cart|checkout|my-account|author/[^/]+)/?$ / [R=301,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>
