# Modele du .env du formulaire de contact (contact/send.php).
# Le vrai fichier se cree sur le serveur, HORS du repo : /home/cararmour/.env
# (un niveau au-dessus de public_html). Jamais commite.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=noreply@example.com
SMTP_PASS=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Car Armour website
MAIL_TO=info@cararmour.sg
